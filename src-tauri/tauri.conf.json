{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "MS Island",
  "version": "1.0.0",
  "identifier": "com.monstar.msisland",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dynamic Island",
        "label": "island",
        "url": "index.html",
        "width": 560,
        "height": 286,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "dragDropEnabled": true
      },
      {
        "title": "Lyrics - MS Island",
        "label": "lyrics",
        "url": "index.html?mode=lyrics",
        "width": 340,
        "height": 468,
        "minWidth": 300,
        "minHeight": 340,
        "visible": false,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Monstar Studio",
    "copyright": "Copyright (C) 2026 Monstar Studio",
    "shortDescription": "Windows Dynamic Island Desktop Command Center",
    "longDescription": "Lightweight Windows Dynamic Island with Synced Lyrics, Pomodoro Timer, Wi-Fi LAN File Shelf, Eyedropper, and System HUD by Monstar Studio.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "C:\\Users\\misba\\.gemini\\config\\skills\\monstar-code-signing\\scripts\\sign_file.ps1",
          "-FilePath",
          "%1"
        ]
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
